{
  "enabledMcpjsonServers": [
    "chrome",
    "edge",
    "cdp"
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__chrome",
      "mcp__edge",
      "mcp__cdp",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Task",
      "TodoWrite",
      "Bash"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(git checkout --:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(grit migrate:*)",
      "Bash(grit seed:*)",
      "Bash(grit deploy:*)",
      "Bash(docker compose down:*)",
      "Bash(format:*)",
      "Bash(shutdown:*)"
    ]
  }
}
