# Run outputs (reports + screenshots) stay local by default.
# Remove these two lines if you want to commit reports.
runs/*
!runs/.gitkeep

# Tasks may contain credentials — never commit them
tasks/*
!tasks/examples/
!tasks/examples/**

.playwright-out/
.env
.env.*
node_modules/
.DS_Store
.claude/settings.local.json

# Self-improvement: per-app notes describe client apps; inbox may hold unfiled issues
knowledge/apps/*
!knowledge/apps/.gitkeep
improvements/
